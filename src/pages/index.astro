---
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#4dabf7" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <title>받아쓰기 풍선 사격</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet" />
  </head>
  <body data-state="menu">
    <canvas id="stage"></canvas>

    <div id="hud">
      <div class="chip left">
        <span id="qnum">1 / 10</span>
        <span id="hearts"></span>
      </div>
      <div class="chip right">
        <span id="combo"></span>
        <span class="score">⭐ <b id="score">0</b></span>
        <span class="score">🪙 <b id="coins">0</b></span>
      </div>
      <div id="board" aria-live="polite"></div>
      <div id="timer" hidden><div id="timer-bar"></div></div>
      <p id="hint" hidden>💡 반짝이는 풍선을 쏴요!</p>
      <div id="crosshair"></div>
      <div class="controls">
        <button id="replay" type="button" aria-label="문제 다시 듣기">🔊 <span>다시 듣기</span></button>
        <button id="pause" type="button" aria-label="잠깐 멈춤">⏸</button>
      </div>
    </div>

    <div id="lap" class="banner">
      <p id="lap-title"></p>
      <p id="lap-sub"></p>
      <p id="lap-desc"></p>
    </div>

    <div id="peek" class="banner">
      <p id="peek-title">👀 소리 대신 눈으로 기억해요</p>
      <p id="peek-text"></p>
      <p id="peek-hint"></p>
    </div>

    <div id="inapp" hidden>
      <span id="inapp-text"></span>
      <button id="inapp-open" type="button">🌐 크롬·사파리로 열기</button>
    </div>

    <div id="warn" class="banner">
      <p id="warn-title">🚫 아무 데나 쏘지 말아요!</p>
      <p id="warn-desc">문제를 잘 듣고, 글자를 찾아서 겨눈 뒤 쏴요</p>
      <p id="warn-count"></p>
      <p id="warn-sub"></p>
    </div>

    <div id="clear" class="banner">
      <p id="clear-stars"></p>
      <p id="clear-text"></p>
      <p id="clear-sticker"></p>
    </div>

    <div id="boss" hidden>
      <div class="boss-top">
        <div id="boss-hp"><div id="boss-hp-bar"></div><span id="boss-hp-text"></span></div>
        <div class="boss-stage">
          <div id="boss-sprite" aria-hidden="true">👹</div>
          <p id="boss-say" role="status"></p>
        </div>
      </div>
      <div id="pad-panel">
        <p id="pad-title">✏️ 다음 글자를 써요</p>
        <div class="pad-row">
          <canvas id="pad" aria-label="글자를 쓰는 칸"></canvas>
          <div class="pad-side">
            <button id="pad-undo" type="button" aria-label="한 획 지우기">↶<span>한 획</span></button>
            <button id="pad-clear" type="button" aria-label="다 지우기">🧽<span>지우기</span></button>
            <button id="pad-replay" type="button" aria-label="문제 다시 듣기">🔊<span>듣기</span></button>
            <button id="pad-pause" type="button" aria-label="잠깐 멈춤">⏸</button>
          </div>
        </div>
        <input id="pad-type" type="text" maxlength="1" placeholder="글자" autocomplete="off" hidden />
        <button id="pad-ok" class="big" type="button">✔ 다 썼어요</button>
      </div>
      <div id="boss-load" class="banner">
        <p id="boss-load-title">🐉 글자 도둑 대왕이 다가온다…</p>
        <p id="boss-load-sub">손글씨 인식 준비 중 0%</p>
      </div>
    </div>

    <section id="login" class="overlay">
      <div class="card">
        <p class="eyebrow">누가 도전하나요?</p>
        <h1>받아쓰기 <br />풍선 사격</h1>
        <div id="login-known" class="chips"></div>
        <form id="login-form" autocomplete="off">
          <input id="login-id" type="text" maxlength="12" placeholder="아이디" autocomplete="off" enterkeyhint="next" />
          <input id="login-pw" type="password" maxlength="20" placeholder="비밀번호 (2글자 이상)" autocomplete="off" enterkeyhint="go" />
          <p id="login-msg" class="status"></p>
          <button id="login-go" class="big" type="submit">들어가기</button>
          <button id="login-first" class="ghost strong" type="button">🌟 처음이에요 · 새로 만들기</button>
        </form>
        <div id="login-new" hidden>
          <p class="status">나만의 아이디를 정해요. 이름과 학교는 적어도 되고 안 적어도 돼요.</p>
          <div class="form">
            <input id="new-id" type="text" maxlength="12" placeholder="아이디 (예: 민수01)" autocomplete="off" />
            <input id="new-pw" type="password" maxlength="20" placeholder="비밀번호 (2글자 이상)" autocomplete="off" />
            <input id="new-name" type="text" maxlength="10" placeholder="이름 (선택)" autocomplete="off" />
            <input id="new-school" type="text" maxlength="20" placeholder="학교 (선택)" autocomplete="off" />
          </div>
          <p id="new-msg" class="status"></p>
          <button id="login-create" class="big" type="button">🌟 만들기</button>
          <button id="login-back" class="ghost" type="button">뒤로</button>
        </div>
        <p class="note">아이디는 친구와 겹치지 않아요. 같은 아이디와 비밀번호로 다음에도 이어서 해요</p>
      </div>
    </section>

    <section id="profile" class="overlay">
      <div class="card small">
        <h2>내 정보</h2>
        <p id="profile-id" class="status"></p>
        <div class="form">
          <input id="profile-name" type="text" maxlength="10" placeholder="이름 (선택)" autocomplete="off" />
          <input id="profile-school" type="text" maxlength="20" placeholder="학교 (선택)" autocomplete="off" />
        </div>
        <p id="profile-msg" class="status"></p>
        <button id="profile-save" class="big" type="button">저장</button>
        <button id="profile-cancel" class="ghost" type="button">취소</button>
      </div>
    </section>

    <section id="menu" class="overlay">
      <div class="card">
        <p class="eyebrow">듣고 · 찾고 · 쏘고</p>
        <h1>받아쓰기 <br />풍선 사격</h1>
        <div class="player">
          <button id="player-name" type="button" title="내 정보">👤</button>
          <button id="fame-open" class="ghost" type="button">🏆 명예의 전당</button>
          <button id="logout" class="ghost" type="button">바꾸기</button>
        </div>
        <button id="set-pick" class="ghost strong setpick" type="button">📚 회차 고르기 ▾</button>
        <button id="continue" class="big continue" type="button" hidden>▶ 이어하기</button>
        <button id="start" class="big" type="button">게임 시작</button>
        <p id="qstatus" class="status"></p>
        <p id="record" class="record"></p>
        <button id="shop-open" class="ghost strong" type="button">🛍️ 꾸미기 상점</button>
        <ul class="howto">
          <li>🔊 문제를 잘 들어요</li>
          <li class="fine">🎯 마우스로 겨누고 클릭해서 글자를 순서대로 쏴요</li>
          <li class="coarse">👆 글자 풍선을 순서대로 톡톡 눌러요</li>
          <li class="fine">⌨️ R 다시 듣기 · Esc 멈춤</li>
        </ul>
        <div class="upload">
          <label class="ghost" for="photo">📷 사진으로 올리기</label>
          <input id="photo" type="file" accept="image/*" hidden />
          <button id="write" class="ghost" type="button">✏️ 직접 쓰기</button>
          <label class="ghost" for="file">📂 파일</label>
          <input id="file" type="file" accept=".txt,.json,text/plain,application/json" hidden />
          <button id="reset" class="ghost" type="button" hidden>기본 문제로</button>
        </div>
        <p class="note">급수표를 찍어 올리거나 한 줄에 한 문제씩 적어요. "7회 [제목]" 줄을 넣으면 회차가 나뉘어요</p>
      </div>
    </section>

    <section id="rounds" class="overlay">
      <div class="card wide">
        <h2>📚 회차 고르기</h2>
        <p class="status">받아쓰기할 회차를 눌러요. 회차마다 단계·바퀴가 따로 이어져요.</p>
        <ol id="rounds-list"></ol>
        <div class="upload">
          <button id="rounds-write" class="ghost strong" type="button">✏️ 새 회차 만들기</button>
          <button id="rounds-close" class="ghost" type="button">닫기</button>
        </div>
      </div>
    </section>

    <section id="editor" class="overlay">
      <div class="card wide">
        <h2>문제 만들기</h2>
        <input id="ed-title" class="ed-title" type="text" maxlength="30" placeholder="회차 이름 (예: 7회 [4. 감동을 나누어요])" autocomplete="off" />
        <div id="ed-photo">
          <canvas id="ed-canvas"></canvas>
          <div class="upload">
            <button id="ed-rotate" class="ghost" type="button">↻ 돌리기</button>
            <button id="ed-scan" class="ghost strong" type="button">🔍 글자 읽기</button>
          </div>
        </div>
        <p id="ed-status" class="status"></p>
        <textarea id="ed-text" rows="10" spellcheck="false" placeholder="한 줄에 한 문제씩 적어요"></textarea>
        <div id="ed-rec" hidden>
          <h3 id="ed-rec-title" class="fame-h"></h3>
          <p id="ed-rec-note" class="fame-note"></p>
          <div id="ed-rec-list"></div>
        </div>
        <button id="ed-save" class="big" type="button">저장</button>
        <button id="ed-cancel" class="ghost" type="button">취소</button>
      </div>
    </section>

    <section id="shop" class="overlay">
      <div class="card wide">
        <h2>꾸미기 상점</h2>
        <p id="shop-coins" class="totals"></p>
        <div id="shop-list"></div>
        <button id="shop-close" class="big" type="button">닫기</button>
      </div>
    </section>

    <section id="paused" class="overlay">
      <div class="card small">
        <h2>잠깐 멈춤</h2>
        <button id="resume" class="big" type="button">계속하기</button>
        <button id="quit" class="ghost" type="button">처음으로</button>
      </div>
    </section>

    <section id="result" class="overlay">
      <div class="card">
        <h2 id="result-title"></h2>
        <p id="result-score" class="totals"></p>
        <p id="result-stars" class="status"></p>
        <ul id="result-coins"></ul>
        <p id="result-total"></p>
        <p id="result-stickers"></p>
        <ol id="result-list"></ol>
        <button id="again" class="big" type="button">다시 하기</button>
        <button id="result-share" class="ghost strong" type="button" hidden>📣 친구에게 자랑하기</button>
        <button id="result-shop" class="ghost strong" type="button">🛍️ 상점</button>
        <button id="home" class="ghost" type="button">처음으로</button>
      </div>
    </section>

    <section id="fame" class="overlay">
      <div class="card wide">
        <h2>🏆 명예의 전당</h2>
        <h3 class="fame-h">👑 우승자 명단</h3>
        <p class="status fame-note">최종 시험을 통과한 모든 우승이 올라와요. 적은 바퀴로 빨리 우승할수록 우승 점수가 높고, 점수가 같으면 공동 순위예요.</p>
        <ol id="winners-list" class="winners"></ol>
        <h3 class="fame-h">👥 모든 친구</h3>
        <p class="status fame-note">이 기기에서 함께 노는 친구들과 링크로 받은 친구들의 명예 점수예요.</p>
        <ol id="fame-list"></ol>
        <button id="fame-share" class="big" type="button">📣 내 기록 자랑하기</button>
        <button id="hall-share" class="ghost strong" type="button">🔗 명예의 전당 전체 보내기</button>
        <div id="share-box" hidden>
          <canvas id="share-card"></canvas>
          <p id="share-status" class="status"></p>
          <textarea id="share-text" rows="4" readonly></textarea>
          <div class="upload">
            <button id="share-copy" class="ghost strong" type="button">📋 글 복사</button>
            <a id="share-download" class="ghost" download="받아쓰기-기록.png">🖼️ 그림 저장</a>
          </div>
        </div>
        <button id="fame-close" class="ghost" type="button">닫기</button>
      </div>
    </section>

    <div id="toast" role="status"></div>

    <script>
      import '../scripts/main.ts';
    </script>

    <style is:global>
      :root {
        --ink: #1d2b53;
        --cream: #fff8e7;
        --coral: #ff5d5d;
        --sun: #ffd23f;
        --mint: #3ddc97;
        --sky: #4dabf7;
        --cell: clamp(30px, 7.2vmin, 58px);
        --edge: 3px solid var(--ink);
        --drop: 0 5px 0 var(--ink);
      }
      * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
      [hidden] { display: none !important; }
      html, body { height: 100%; margin: 0; overflow: hidden; overscroll-behavior: none; }
      body {
        font-family: 'Jua', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
        color: var(--ink);
        background: linear-gradient(#3d9df0 0%, #8fd3ff 48%, #e3f6ff 78%, #bdeeb0 100%);
        user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
      }
      #stage { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
      button, label { font: inherit; color: inherit; cursor: pointer; touch-action: manipulation; }

      /* ── HUD ── */
      #hud {
        position: fixed; inset: 0; pointer-events: none; display: none;
        padding: max(10px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right))
          max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
      }
      body:is([data-state='playing'], [data-state='between'], [data-state='paused'], [data-state='boss']) #hud { display: block; }
      body[data-state='boss'] :is(.controls, #crosshair, #hint) { display: none !important; }
      .chip {
        position: absolute; top: max(10px, env(safe-area-inset-top)); display: flex; gap: 10px; align-items: center;
        background: var(--cream); border: var(--edge); border-radius: 999px; padding: 4px 14px;
        font-size: clamp(15px, 3.4vmin, 22px); box-shadow: 0 3px 0 var(--ink);
      }
      .chip.left { left: max(12px, env(safe-area-inset-left)); }
      .chip.right { right: max(12px, env(safe-area-inset-right)); }
      #hearts { letter-spacing: 1px; display: inline-block; }
      #hearts.shake { animation: shake 0.4s; }
      #combo { color: var(--coral); }
      #combo:empty { display: none; }
      .score b { font-weight: 400; font-variant-numeric: tabular-nums; }

      #board {
        margin: calc(clamp(15px, 3.4vmin, 22px) + 30px) auto 0; width: fit-content; max-width: 100%;
        display: flex; flex-wrap: wrap; justify-content: center; gap: 8px calc(var(--cell) * 0.45);
        background: rgb(255 248 231 / 0.92); border: var(--edge); border-radius: 18px;
        padding: 10px 14px; box-shadow: var(--drop);
      }
      .word { display: flex; gap: 4px; }
      .cell {
        width: var(--cell); height: var(--cell); display: grid; place-items: center;
        font-size: calc(var(--cell) * 0.7); line-height: 1;
        background: #fff; border: 2px dashed #9aa5c4; border-radius: 10px;
      }
      .cell.auto { width: calc(var(--cell) * 0.4); background: none; border-color: transparent; }
      .cell.next { border: 3px solid var(--coral); animation: pulse 1s infinite; }
      .cell.filled:not(.auto) { background: var(--sun); border: 2px solid var(--ink); animation: land 0.3s; }
      .cell.filled.given:not(.auto) { background: #fff; border: 2px solid #c3cbe0; color: #6b7699; animation: none; }
      #timer {
        width: min(70%, 360px); height: 14px; margin: 10px auto 0; overflow: hidden;
        background: rgb(255 248 231 / 0.9); border: var(--edge); border-radius: 999px;
      }
      #timer[hidden] { display: none; }
      #timer-bar { height: 100%; background: linear-gradient(90deg, var(--coral), var(--sun)); border-radius: 999px; }
      #lap { z-index: 3; }
      #lap-title { font-size: clamp(30px, 8vmin, 54px); }
      #lap-sub { font-size: clamp(16px, 4vmin, 24px); color: var(--coral); margin-top: 4px; }
      #lap-desc { font-size: clamp(15px, 3.6vmin, 22px); margin-top: 6px; }
      #result-coins { list-style: none; margin: 8px 0 4px; padding: 8px 12px; text-align: left; background: #fff; border-radius: 12px; font-size: 16px; }
      #result-coins li { display: flex; justify-content: space-between; gap: 10px; line-height: 1.7; }
      #result-coins b { font-weight: 400; color: #b0620a; white-space: nowrap; }
      #result-total { margin: 4px 0 10px; font-size: 20px; color: #b0620a; }
      #shop-list h3 { margin: 12px 0 6px; font-weight: 400; font-size: 20px; text-align: left; }
      .shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 8px; }
      .item {
        display: grid; gap: 2px; justify-items: center; padding: 8px 4px; font-size: 15px;
        background: #fff; border: var(--edge); border-radius: 14px; opacity: 0.85;
      }
      .item-icon { font-size: 30px; line-height: 1.1; height: 46px; display: grid; place-items: center; }
      .item-name { font-size: 15px; }
      .item-desc { font-size: 12px; color: #5a6a92; line-height: 1.2; }
      .item-tag { font-size: 14px; color: #b0620a; }
      .item.locked { opacity: 0.55; }
      .item.final { background: linear-gradient(160deg, #fff3bf, #ffe8cc 60%, #e5dbff); border-color: #b0620a; grid-column: span 2; }
      .item.final .item-icon { font-size: 44px; filter: drop-shadow(0 0 8px #ffd43b); animation: bob 1.6s ease-in-out infinite; }
      .item.final.on { background: linear-gradient(160deg, #ffd43b, #ff922b); }
      .item.owned { opacity: 1; }
      .item.owned .item-tag { color: #5a6a92; }
      .item.on { background: var(--sun); box-shadow: 0 3px 0 var(--ink); }
      .item.on .item-tag { color: var(--ink); }
      .item:active { transform: translateY(2px); }
      #shop .card { margin-bottom: 30vh; }
      #hint {
        width: fit-content; margin: 10px auto 0; padding: 4px 14px; border-radius: 999px;
        background: var(--sun); border: var(--edge); font-size: clamp(14px, 3vmin, 20px);
      }
      #hint[hidden] { display: none; }

      #crosshair {
        position: absolute; left: 50%; top: 50%; width: 34px; height: 34px; margin: -17px;
        border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 2px var(--ink), inset 0 0 0 2px var(--ink);
        display: none;
      }
      #crosshair::after {
        content: ''; position: absolute; inset: 11px; background: var(--coral); border-radius: 50%;
        box-shadow: 0 0 0 2px #fff;
      }
      body.locked[data-state='playing'] #crosshair { display: block; }

      .controls {
        position: absolute; left: max(12px, env(safe-area-inset-left)); bottom: max(14px, env(safe-area-inset-bottom));
        display: flex; gap: 10px; pointer-events: auto;
      }
      .controls button {
        min-width: 56px; min-height: 56px; padding: 0 18px; font-size: 22px;
        background: var(--cream); border: var(--edge); border-radius: 18px; box-shadow: var(--drop);
      }
      .controls button:active { transform: translateY(4px); box-shadow: 0 1px 0 var(--ink); }
      #replay { background: var(--sun); }

      /* ── 정답 배너 ── */
      .banner {
        position: fixed; left: 50%; top: 50%; translate: -50% -50%; text-align: center; pointer-events: none;
        background: var(--cream); border: var(--edge); border-radius: 26px; padding: 18px 32px;
        box-shadow: 0 8px 0 var(--ink); opacity: 0; scale: 0.6; transition: opacity 0.2s, scale 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
        width: max-content; max-width: 92vw;
      }
      .banner.show { opacity: 1; scale: 1; }
      .banner p { margin: 0; }
      #clear-stars { font-size: clamp(34px, 9vmin, 60px); }
      #clear-text { font-size: clamp(22px, 5.5vmin, 40px); }
      #clear-sticker { margin-top: 6px; font-size: clamp(18px, 4.4vmin, 28px); color: var(--coral); }
      .record { margin: 6px 0 0; font-size: 16px; color: #b0620a; }
      #result-stickers { margin: 0 0 10px; font-size: 30px; letter-spacing: 2px; line-height: 1.3; }
      #result-stickers:empty { display: none; }

      /* ── 오버레이 ── */
      .overlay {
        position: fixed; inset: 0; display: none; overflow-y: auto;
        padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom));
        background: rgb(29 43 83 / 0.28);
      }
      body[data-state='editor'] #editor, body[data-state='shop'] #shop, body[data-state='menu'] #menu, body[data-state='paused'] #paused,
      body[data-state='result'] #result, body[data-state='login'] #login, body[data-state='fame'] #fame, body[data-state='profile'] #profile,
      body[data-state='rounds'] #rounds { display: grid; }
      .card {
        margin: auto; width: min(100%, 440px); text-align: center;
        background: var(--cream); border: 4px solid var(--ink); border-radius: 30px;
        padding: 26px 24px 22px; box-shadow: 0 10px 0 var(--ink);
      }
      .card.small { width: min(100%, 320px); }
      .card.wide { width: min(100%, 560px); }
      #ed-canvas { display: block; max-width: 100%; max-height: 34vh; margin: 0 auto; border: var(--edge); border-radius: 12px; background: #fff; }
      #ed-text {
        display: block; width: 100%; margin: 10px 0 14px; padding: 10px 12px; resize: vertical;
        font: 20px/1.6 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; color: var(--ink);
        border: var(--edge); border-radius: 14px; background: #fff; user-select: text; -webkit-user-select: text;
      }
      .ghost.strong { background: var(--sun); }
      .ghost:disabled { opacity: 0.5; }
      .eyebrow { margin: 0; color: var(--coral); font-size: 18px; letter-spacing: 2px; }
      h1 { margin: 4px 0 18px; font-weight: 400; font-size: clamp(40px, 11vmin, 62px); line-height: 1.05; }
      h2 { margin: 0 0 12px; font-weight: 400; font-size: clamp(30px, 8vmin, 44px); }
      .big {
        display: block; width: 100%; min-height: 64px; font-size: 28px;
        background: var(--coral); color: #fff; border: 4px solid var(--ink); border-radius: 20px; box-shadow: 0 6px 0 var(--ink);
      }
      .big:active { transform: translateY(5px); box-shadow: 0 1px 0 var(--ink); }
      .ghost {
        display: inline-block; margin-top: 12px; padding: 10px 18px; min-height: 46px; font-size: 18px;
        background: #fff; border: var(--edge); border-radius: 14px;
      }
      :is(.big, .ghost, .controls button):focus-visible { outline: 4px solid var(--sky); outline-offset: 3px; }
      .status { margin: 12px 0 0; font-size: 17px; }
      .howto { list-style: none; margin: 14px 0 4px; padding: 12px 14px; text-align: left; font-size: 17px; line-height: 1.7; background: #fff; border-radius: 16px; }
      .howto .coarse { display: none; }
      @media (pointer: coarse) {
        .howto .coarse { display: list-item; }
        .howto .fine { display: none; }
      }
      .upload { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
      .note { margin: 8px 0 0; font-size: 14px; opacity: 0.7; }

      .totals { margin: 0 0 6px; font-size: 22px; }
      #result-list { margin: 0 0 16px; padding: 0; list-style: none; text-align: left; max-height: 26vh; overflow-y: auto; }
      #result-list li {
        display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; padding: 8px 12px; margin-bottom: 6px;
        background: #fff; border-radius: 12px; font-size: 18px;
      }
      .r-wrong { grid-column: 1 / -1; color: var(--coral); font-size: 15px; }

      /* ── 날아가는 글자 · 알림 ── */
      .fly {
        position: fixed; z-index: 5; translate: -50% -50%; pointer-events: none; font-size: 64px; line-height: 1;
        color: var(--ink); text-shadow: 0 0 0 #fff, 2px 2px 0 #fff, -2px -2px 0 #fff, 2px -2px 0 #fff, -2px 2px 0 #fff;
        transition: left 0.32s ease-in, top 0.32s ease-in, font-size 0.32s ease-in;
      }
      #toast {
        position: fixed; left: 50%; bottom: max(90px, calc(env(safe-area-inset-bottom) + 90px)); translate: -50% 20px;
        max-width: 90vw; padding: 10px 18px; font-size: 18px; text-align: center; pointer-events: none;
        background: var(--ink); color: #fff; border-radius: 16px; opacity: 0; transition: opacity 0.2s, translate 0.2s;
        z-index: 7;
      }
      #toast.show { opacity: 1; translate: -50% 0; }
      body[data-state='boss'] #toast { bottom: auto; top: 24%; }

      .pop {
        position: fixed; z-index: 6; translate: -50% -50%; pointer-events: none; white-space: nowrap;
        font-size: clamp(22px, 5vmin, 34px); color: var(--sun);
        -webkit-text-stroke: 6px var(--ink); paint-order: stroke fill;
        animation: rise 0.95s ease-out forwards;
      }
      .pop.oops { color: #fff; }
      .pop.bonus { color: #fff; font-size: clamp(28px, 7vmin, 46px); -webkit-text-stroke-color: #e8590c; }
      .pop.praise { color: var(--mint); font-size: clamp(40px, 11vmin, 84px); -webkit-text-stroke-width: 10px; animation-name: cheer; }
      @keyframes rise { from { opacity: 1; scale: 0.6; } 20% { scale: 1.15; } to { opacity: 0; translate: -50% -170%; } }
      @keyframes cheer { from { opacity: 0; scale: 0.3; rotate: -8deg; } 25% { opacity: 1; scale: 1.1; rotate: 3deg; } 70% { opacity: 1; scale: 1; } to { opacity: 0; scale: 1.2; } }
      .marker {
        position: fixed; z-index: 4; width: 44px; height: 44px; margin: -22px; pointer-events: none;
        border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 2px rgb(29 43 83 / 0.7);
        animation: ring 0.3s ease-out forwards;
      }
      .marker.hit { border-color: var(--sun); }
      .marker.hit::before, .marker.hit::after {
        content: ''; position: absolute; left: 50%; top: 50%; width: 30px; height: 4px; margin: -2px -15px;
        background: #fff; border-radius: 2px; box-shadow: 0 0 0 1.5px var(--ink); rotate: 45deg;
      }
      .marker.hit::after { rotate: -45deg; }
      @keyframes ring { from { scale: 0.4; opacity: 1; } to { scale: 1.25; opacity: 0; } }
      @keyframes pulse { 50% { box-shadow: 0 0 0 5px rgb(255 93 93 / 0.3); } }
      @keyframes land { from { scale: 1.5; } }
      @keyframes shake { 25% { translate: -5px 0; } 50% { translate: 5px 0; } 75% { translate: -3px 0; } }

      /* ── 로그인 · 명예의 전당 ── */
      #login-form, .form { display: grid; gap: 10px; margin-top: 12px; }
      #login-form .ghost { margin-top: 0; }
      #login-form input, .form input, #pad-type {
        width: 100%; min-height: 54px; padding: 8px 14px; font: 22px 'Jua', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
        color: var(--ink); background: #fff; border: var(--edge); border-radius: 14px; text-align: center;
        user-select: text; -webkit-user-select: text;
      }
      #login-form input:focus-visible, .form input:focus-visible, #pad-type:focus-visible { outline: 4px solid var(--sky); outline-offset: 2px; }
      #new-msg, #profile-msg { color: var(--coral); margin-top: 8px; }
      #new-msg:empty, #profile-msg:empty { display: none; }
      .big.continue { background: var(--mint); color: var(--ink); margin-bottom: 10px; }
      .setpick { display: block; width: 100%; margin: 0 0 10px; font-size: 18px; white-space: normal; }
      .ed-title {
        display: block; width: 100%; margin: 0 0 8px; padding: 8px 12px; min-height: 48px; font: 19px 'Jua', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif;
        color: var(--ink); background: #fff; border: var(--edge); border-radius: 14px; user-select: text; -webkit-user-select: text;
      }
      #rounds-list { list-style: none; margin: 10px 0 12px; padding: 0; text-align: left; max-height: 50vh; overflow-y: auto; }
      .round { display: flex; gap: 6px; align-items: stretch; margin-bottom: 8px; }
      .round-main {
        flex: 1; min-width: 0; display: grid; gap: 2px; text-align: left; padding: 10px 14px;
        background: #fff; border: var(--edge); border-radius: 14px; box-shadow: 0 3px 0 var(--ink);
      }
      .round.on .round-main { background: var(--sun); }
      .round-main:active { translate: 0 3px; box-shadow: none; }
      .round-title { font-size: 19px; }
      .round-detail { font-size: 14px; color: #5a6a92; }
      .round-btn { min-width: 46px; font-size: 18px; background: var(--cream); border: var(--edge); border-radius: 12px; }
      #login-form .big { margin-top: 2px; }
      #login-msg:empty { display: none; }
      #login-msg { color: var(--coral); margin-top: 0; }
      .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 10px; }
      .chips:empty { display: none; }
      .chip-btn {
        padding: 6px 14px; font-size: 17px; background: #fff; border: 2px solid var(--ink); border-radius: 999px;
      }
      .chip-btn:active { translate: 0 2px; }
      .player {
        display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; margin: -6px 0 14px;
        font-size: 18px;
      }
      .player .ghost { margin-top: 0; padding: 6px 12px; min-height: 40px; font-size: 16px; }
      #player-name { padding: 6px 12px; font-size: 18px; background: var(--sun); border: 2px solid var(--ink); border-radius: 999px; }
      #fame-list { list-style: none; margin: 10px 0 14px; padding: 0; text-align: left; max-height: 40vh; overflow-y: auto; }
      #fame-list li {
        display: grid; grid-template-columns: auto 1fr auto; gap: 2px 10px; align-items: center;
        padding: 8px 12px; margin-bottom: 6px; background: #fff; border-radius: 12px; font-size: 18px;
      }
      #fame-list li.me { background: var(--sun); border: 2px solid var(--ink); }
      #fame .f-rank { font-size: 24px; min-width: 34px; text-align: center; }
      #fame .f-name { font-size: 20px; }
      #fame .f-fame { color: #b0620a; white-space: nowrap; }
      #fame .f-detail { grid-column: 2 / -1; font-size: 15px; color: #5a6a92; }
      #fame-list:empty::before { content: '아직 기록이 없어요. 게임을 해 봐요!'; display: block; text-align: center; padding: 14px; color: #5a6a92; }
      .fame-h { margin: 14px 0 2px; font-weight: 400; font-size: 22px; text-align: left; }
      .fame-note { margin: 0 0 8px; font-size: 14px; color: #5a6a92; text-align: left; }
      #winners-list { list-style: none; margin: 0 0 6px; padding: 0; text-align: left; max-height: 36vh; overflow-y: auto; }
      #winners-list li {
        display: grid; grid-template-columns: auto 1fr auto; gap: 2px 10px; align-items: center;
        padding: 8px 12px; margin-bottom: 6px; background: #fff; border-radius: 12px; font-size: 18px;
      }
      #winners-list li.top { background: linear-gradient(90deg, #fff3bf, #fff); border: 2px solid var(--sun); }
      #winners-list li.me { outline: 3px solid var(--coral); }
      #winners-list .f-rank { font-size: 16px; white-space: nowrap; }
      #winners-list:empty::before { content: '아직 우승자가 없어요. 최종 시험을 통과해 이름을 올려요!'; display: block; text-align: center; padding: 14px; color: #5a6a92; }
      #peek { z-index: 8; top: 38%; }
      #peek-title { font-size: clamp(16px, 3.8vmin, 22px); color: var(--coral); }
      #peek-text { font-size: clamp(26px, 7vmin, 44px); margin-top: 6px; }
      #peek-hint { font-size: 14px; color: #5a6a92; margin-top: 8px; max-width: 80vw; white-space: normal; }
      #inapp {
        position: fixed; left: 0; right: 0; top: 0; z-index: 9; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center;
        padding: max(8px, env(safe-area-inset-top)) 12px 8px; background: var(--sun); border-bottom: var(--edge); font-size: 15px; text-align: center;
      }
      #inapp[hidden] { display: none; }
      #inapp button { padding: 6px 12px; font-size: 15px; background: var(--ink); color: #fff; border: 0; border-radius: 999px; }
      body:not([data-state='menu']):not([data-state='login']) #inapp { display: none; }
      #ed-rec { text-align: left; margin: 0 0 12px; }
      .rec-row { display: flex; gap: 6px; align-items: center; padding: 6px 8px; margin-bottom: 4px; background: #fff; border-radius: 10px; font-size: 16px; }
      .rec-row.recording { background: #ffe3e3; animation: pulse 1s infinite; }
      .rec-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rec-btn { min-width: 40px; min-height: 36px; padding: 0 10px; font-size: 16px; background: var(--cream); border: 2px solid var(--ink); border-radius: 10px; }
      .rec-btn.rec { background: var(--coral); color: #fff; }
      .rec-btn.stop { background: var(--ink); color: #fff; }
      #warn { z-index: 8; border-color: var(--coral); box-shadow: 0 8px 0 var(--coral); }
      #warn-title { font-size: clamp(26px, 6vmin, 40px); color: var(--coral); }
      #warn-desc { font-size: clamp(16px, 3.8vmin, 22px); margin-top: 4px; }
      #warn-count { font-size: clamp(18px, 4.4vmin, 26px); margin-top: 8px; }
      #warn-sub { font-size: 15px; color: #b0620a; margin-top: 4px; }
      #warn.show { animation: shake 0.4s; }
      #share-box { margin-top: 12px; }
      #share-card { display: block; width: 100%; height: auto; border: var(--edge); border-radius: 14px; background: #fff; }
      #share-text {
        display: block; width: 100%; margin: 10px 0 4px; padding: 8px 10px; resize: none;
        font: 15px/1.5 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif; color: var(--ink);
        border: var(--edge); border-radius: 12px; background: #fff; user-select: text; -webkit-user-select: text;
      }
      #share-download { text-decoration: none; }

      /* ── 최종 시험(보스전) ── */
      #boss { position: fixed; inset: 0; pointer-events: none; display: flex; flex-direction: column; z-index: 2; }
      #boss[hidden] { display: none !important; }
      body[data-state='paused'] #boss, body[data-state='result'] #boss { display: none !important; }
      .boss-top {
        flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
        padding-top: calc(var(--cell) + clamp(15px, 3.4vmin, 22px) + 70px); min-height: 0;
      }
      #boss-hp {
        position: relative; width: min(86vw, 520px); height: 26px; overflow: hidden;
        background: rgb(29 43 83 / 0.7); border: var(--edge); border-radius: 999px;
      }
      #boss-hp-bar { height: 100%; background: linear-gradient(90deg, #ff5d5d, #ff9f43); border-radius: 999px; transition: width 0.3s; }
      #boss[data-phase='1'] #boss-hp-bar { background: linear-gradient(90deg, #ff3b3b, #ff5d5d); }
      #boss[data-phase='2'] #boss-hp-bar { background: linear-gradient(90deg, #c9184a, #ff3b3b); }
      #boss-hp-text {
        position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 16px;
        text-shadow: 0 1px 0 var(--ink), 0 0 6px var(--ink);
      }
      .boss-stage { position: relative; display: grid; place-items: center; order: 1; }
      #boss-hp { order: 2; margin-top: 4px; }
      #boss-sprite {
        font-size: clamp(80px, 22vmin, 170px); line-height: 1.2; filter: drop-shadow(0 10px 0 rgb(0 0 0 / 0.35));
        animation: bob 2.2s ease-in-out infinite; transform-origin: 50% 80%;
      }
      #boss[data-phase='1'] #boss-sprite { animation-duration: 1.4s; filter: drop-shadow(0 10px 0 rgb(0 0 0 / 0.35)) drop-shadow(0 0 18px #ff5d5d); }
      #boss[data-phase='2'] #boss-sprite { animation-duration: 0.8s; filter: drop-shadow(0 10px 0 rgb(0 0 0 / 0.35)) drop-shadow(0 0 28px #ff3b3b); }
      #boss-sprite.intro { animation: enter 1.5s cubic-bezier(0.3, 1.6, 0.5, 1); }
      #boss-sprite.hurt { animation: hurt 0.45s; }
      #boss-sprite.attack { animation: lunge 0.65s cubic-bezier(0.4, 0, 0.2, 1); }
      #boss-sprite.beaten { animation: beaten 1.6s ease-in forwards; }
      #boss-say {
        position: absolute; top: -6px; left: 50%; translate: -50% -100%; margin: 0; width: max-content; max-width: 86vw;
        padding: 8px 16px; font-size: clamp(16px, 3.6vmin, 22px); text-align: center;
        background: #fff; border: var(--edge); border-radius: 18px; box-shadow: 0 4px 0 var(--ink);
        opacity: 0; scale: 0.6; transition: opacity 0.15s, scale 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
      }
      #boss-say::after {
        content: ''; position: absolute; left: 50%; bottom: -12px; margin-left: -8px;
        border: 8px solid transparent; border-top-color: var(--ink); border-bottom: 0;
      }
      #boss-say.show { opacity: 1; scale: 1; }
      #pad-panel {
        pointer-events: auto; margin: 0 auto; width: min(100%, 520px);
        padding: 10px 12px max(12px, env(safe-area-inset-bottom));
        background: var(--cream); border: var(--edge); border-bottom: 0; border-radius: 26px 26px 0 0; box-shadow: 0 -4px 0 rgb(29 43 83 / 0.35);
      }
      #pad-title { margin: 0 0 8px; text-align: center; font-size: clamp(16px, 3.8vmin, 22px); }
      .pad-row { display: flex; gap: 10px; justify-content: center; align-items: stretch; }
      #pad {
        width: min(62vw, 36vh, 280px); aspect-ratio: 1; display: block; touch-action: none; cursor: crosshair;
        background: #fff; border: var(--edge); border-radius: 18px;
      }
      .pad-side { display: grid; gap: 6px; align-content: stretch; }
      .pad-side button {
        display: grid; place-items: center; line-height: 1; min-width: 60px; padding: 4px 8px; font-size: 22px;
        background: #fff; border: var(--edge); border-radius: 14px; box-shadow: 0 3px 0 var(--ink);
      }
      .pad-side button span { font-size: 12px; }
      .pad-side button:active { translate: 0 3px; box-shadow: none; }
      #pad-ok { margin-top: 10px; min-height: 56px; font-size: 24px; background: var(--mint); color: var(--ink); }
      #pad-ok:disabled { opacity: 0.6; }
      #pad-panel.busy #pad { opacity: 0.6; }
      #pad-type { margin-top: 10px; }
      body[data-state='boss'] #timer { width: min(86vw, 520px); }
      body[data-state='boss'] #timer-bar { background: linear-gradient(90deg, var(--mint), var(--sun)); transition: width 0.25s linear; }
      body[data-state='boss'].hurry #timer-bar { background: var(--coral); }
      body[data-state='boss'].hurry #timer { animation: pulse 0.5s infinite; }
      #boss-load { z-index: 3; }
      #boss-load-title { font-size: clamp(24px, 6vmin, 40px); }
      #boss-load-sub { font-size: clamp(15px, 3.6vmin, 22px); color: var(--coral); margin-top: 6px; }
      body.quake { animation: quake 0.5s; }
      @keyframes bob { 50% { translate: 0 -10px; } }
      @keyframes enter { from { scale: 0; rotate: -30deg; opacity: 0; } 60% { scale: 1.25; } }
      @keyframes hurt { 20% { translate: -14px 0; filter: brightness(3); } 40% { translate: 14px 0; } 60% { translate: -8px 0; filter: brightness(2); } 80% { translate: 8px 0; } }
      @keyframes lunge { 30% { scale: 1.35; translate: 0 40px; filter: brightness(1.3); } 55% { scale: 1.35; translate: 0 40px; } }
      @keyframes beaten { 30% { rotate: 20deg; } 60% { rotate: -25deg; opacity: 1; } to { translate: 0 60vh; rotate: 180deg; opacity: 0; } }
      @keyframes quake { 10% { translate: -8px 4px; } 30% { translate: 8px -4px; } 50% { translate: -6px 2px; } 70% { translate: 6px -2px; } 90% { translate: -3px 1px; } }

      /* 낮은 가로 화면(휴대폰 가로) */
      @media (max-height: 460px) {
        .card { padding: 14px 20px; width: min(100%, 620px); }
        h1 { font-size: 34px; margin-bottom: 8px; }
        h1 br { display: none; }
        .howto { margin: 8px 0 0; padding: 6px 12px; font-size: 15px; line-height: 1.4; }
        .big { min-height: 50px; font-size: 22px; }
        #replay span { display: none; }
        #board { padding: 6px 10px; }
        #boss-sprite { font-size: clamp(60px, 26vh, 120px); }
        #pad-panel { padding: 6px 10px 6px; }
        #pad { width: min(30vw, 52vh); }
        #pad-ok { min-height: 42px; font-size: 18px; margin-top: 6px; }
        #pad-title { margin-bottom: 4px; }
      }
      /* 가로 화면: 보스는 패드 옆에 선다 */
      @media (orientation: landscape) and (min-width: 640px) {
        #boss { flex-direction: row; align-items: flex-end; justify-content: center; gap: clamp(10px, 3vw, 40px); }
        .boss-top { flex: 0 1 auto; justify-content: flex-end; padding: 0 0 clamp(10px, 4vh, 40px); }
        #boss-hp { width: min(38vw, 420px); }
        #boss-sprite { font-size: clamp(90px, 30vh, 190px); }
        #pad-panel { margin: 0; width: min(46vw, 480px); }
        #pad { width: min(28vw, 40vh, 280px); }
      }
      @media (prefers-reduced-motion: reduce) {
        .cell.next, #hearts.shake, #boss-sprite, body.quake { animation: none; }
      }
    </style>
  </body>
</html>
